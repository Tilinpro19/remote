<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema Cyber Dark sin ActionBar para permitir Compose Edge-To-Edge completo -->
    <style name="Theme.UniversalRemote" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#0F131C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Botones del widget de escritorio (RemoteViews no admite Compose) -->
    <style name="RemoteWidgetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">#E0E6F0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
